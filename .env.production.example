# Production Environment Variables
# 部署到宝塔 Docker 时，将这些变量填入宝塔 → Docker → 环境变量，或创建此文件后 docker compose 自动读取

# 网站域名
PUBLIC_BASE_URL=website-url

# 阿里云 RDS PostgreSQL
DB_HOST=pgm-xxxxxxxx.pgsql.cn-chengdu.rds.aliyuncs.com
DB_PORT=5432
DB_USER=usXXX31
DB_PASSWORD=your_password
DB_NAME=platform
DB_SSL=false

# JWT 密钥（生产环境务必更换为强随机字符串）
JWT_SECRET=change-me-to-a-random-string

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=zhXXXnt
OSS_ACCESS_KEY_ID=your_key_id
OSS_ACCESS_KEY_SECRET=your_key_secret
OSS_PUBLIC_HOST=zXXX-agent.oss-cn-beijing.aliyuncs.com

# SMTP 邮箱配置（用于发送验证码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code

# Redis（邮件队列 Bull 后端，默认指向 compose 内 redis 服务，一般无需修改）
REDIS_URL=redis://redis:6379

# 微信开放平台（网站应用）
# WECHAT_LOGIN_ENABLED 为总开关：同时控制前端登录按钮显隐 + 后端微信链路断言；上线改为 true
WECHAT_LOGIN_ENABLED=false
WECHAT_APPID=wxb2XXXX6a7
WECHAT_APPSECRET=your_wechat_app_secret
# 微信登录回调地址（必须与开放平台"授权回调域名"一致且为 https）；本地是 localhost，上线必须改
WECHAT_REDIRECT_URI=https://website-url/api/auth/wechat/callback

# ──────────────────────────────────────────────
# 微信公众号（已认证服务号）
# 该凭证同时服务于两处，且都与上面的「网站应用登录(WECHAT_APPID)」是两套独立 AppID / OpenID 命名空间，不可混用：
#   1. 网页分享 JS-SDK：/api/wechat/jssdk 生成签名；
#   2. 微信内网页授权静默登录（snsapi_base）：/api/auth/wechat/mp/* 用此 AppID 换 openid（网页授权域名配在该公众号下）。
# 注意：
#   1. 订阅号没有 JS-SDK / 网页授权权限，须「已认证服务号」；
#   2. 公众号后台「公众号设置 → 功能设置 → 网页授权域名」须添加 skills.rehomi.com，校验文件放站点根目录；
#   3. 若同时开启 PC 网站应用扫码登录，WECHAT_APPID 应填网站应用(wx4e9b…)，与本公众号凭证各自独立。
# ──────────────────────────────────────────────
WECHAT_OA_APPID=your_official_account_appid
WECHAT_OA_APPSECRET=your_official_account_appsecret

# ──────────────────────────────────────────────
# 微信支付（商户模式：平台全额收款 → 记创作者余额 → 提现）
# 全部在微信支付商户平台 pay.weixin.qq.com 获取，详见部署教程「支付模块资料获取」一节。
# 重要：支付 AppID = 公众号 AppID（wxb2537aa7600236a7），≠ 网站扫码登录 AppID（wx4e9b…），二者 openid 不同！
#       公众号须在商户平台「AppID账号管理」绑定；Native 支付产品须已开通。
# 回调地址由代码按 PUBLIC_BASE_URL 自动拼接（{PUBLIC_BASE_URL}/api/pay/wechat/notify），无需在此配置。
# PEM 私钥/平台证书：粘完整 PEM 文本即可（含 -----BEGIN 多行，或用 \n 转义成单行 + 双引号包裹，代码 resolvePem 自动还原）。
# ──────────────────────────────────────────────
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_APPID=wxb2537aa7600236a7              # 支付用 AppID = 公众号 AppID（≠ 网站登录 AppID），默认即公众号 AppID
WECHAT_PAY_SERIAL_NO=your_cert_serial           # 商户 API 证书序列号
WECHAT_PAY_APIV3_KEY=your_apiv3_key             # APIv3 密钥（32 字节，回调解密 + 平台证书下载）
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # 商户证书私钥（签名用，不可外泄）
WECHAT_PAY_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----" # 微信平台证书公钥（回调验签，用 CertificateDownloader 拉取）
